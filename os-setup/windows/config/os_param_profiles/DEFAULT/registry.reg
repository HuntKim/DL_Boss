Windows Registry Editor Version 5.00

; ==============================================================================
; os_param_profiles/DEFAULT/registry.reg
; ==============================================================================
; 네이티브 .reg 형식 그대로 작성한다 (reg import로 그대로 적용 가능,
; 커스텀 파싱 불필요). OsParam-Apply.ps1은 이 파일을 "reg import"로
; 적용하고, 검증/롤백을 위해 dword/string 값만 별도로 읽어서 추적한다
; (binary/multi-string 등은 적용은 되지만 검증/백업 대상에서는 제외됨 -
; 스크립트가 실행 시 경고로 알려줌).
;
; 아래 값은 예시이며, 실제 AS-IS 서버에서 Assessment 스크립트로 수집한
; os_parameters.txt를 참고해 이 프로파일에 맞는 실제 값으로 채워야 한다.
; ==============================================================================

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters]
"TcpTimedWaitDelay"=dword:0000001e

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management]
"LargeSystemCache"=dword:00000001
