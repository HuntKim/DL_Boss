# ==============================================================================
# config/env/<hostname>.ps1  (예시 템플릿)
# ==============================================================================
# 파일명은 반드시 $env:COMPUTERNAME 값과 정확히 일치해야 한다(대소문자
# 무관하게 매칭됨). 이 파일 하나가 해당 호스트의 계정/그룹, 스토리지,
# 디렉터리 권한, OS 파라미터 프로파일을 전부 정의한다 (CSV 미사용).
#
# 이 파일을 복사해서 실제 호스트명으로 이름을 바꾸고 값을 채워 사용한다.
#   Copy-Item example_host.ps1.template RTPGARGA01M.ps1
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 커스텀 그룹 정의
#   Administrators/Users/Remote Desktop Users 같은 내장 그룹은 항상
#   존재하므로 여기 선언할 필요 없다(계정의 소속 그룹으로만 참조하면 됨).
#   여기는 이 프로젝트에서 새로 만들어야 하는 "앱 전용" 그룹만 나열한다.
# ------------------------------------------------------------------------------
$HostGroups = @(
    "amsgroup"
    "simax"
)

# ------------------------------------------------------------------------------
# 2. 계정 정의
#   User: 계정명 / Groups: 소속시킬 그룹 목록(내장 그룹 + 위 커스텀 그룹)
#   ※ 비밀번호는 아래 HostInitialPassword 하나를 새로 생성되는 모든 계정에
#     동일하게 적용한다(계정마다 다른 비밀번호를 관리하는 번거로움을
#     없애기 위함). 담당자가 이 비밀번호로 로그온해 바로 자신의 비밀번호로
#     바꾸는 것을 전제로 하며, 계정은 "다음 로그온 시 암호 변경 필수"로
#     설정된다.
# ------------------------------------------------------------------------------
$HostAccounts = @(
    @{ User = "AMSADMIN";  Groups = @("Administrators", "amsgroup") }
    @{ User = "smprc";     Groups = @("Users", "simax") }
    @{ User = "osmanaged"; Groups = @("Administrators", "Remote Desktop Users") }
)

# 새로 생성되는 모든 계정에 적용할 초기 비밀번호(평문). Windows 로컬 계정
# 정책(대문자/소문자/숫자/특수문자 등 복잡도 요건)을 만족해야 계정 생성이
# 성공한다. 다음 로그온 시 담당자가 즉시 변경하는 일회성 값이다.
$HostInitialPassword = "ChangeMe123!"

# ------------------------------------------------------------------------------
# 3. Storage(볼륨) 정의
#   형식: "드라이브문자:크기(GB):볼륨레이블"
#   초기화되지 않은(RAW) 디스크를 순서대로 자동 배정한다.
# ------------------------------------------------------------------------------
$HostVolumes = @(
    "F:150:AppData"
    "G:200:Logs"
)

# ------------------------------------------------------------------------------
# 4. 디렉터리 권한(NTFS ACL) 정의
#   형식: "경로:계정또는그룹:권한수준"
#   권한수준: FullControl / Modify / ReadAndExecute 중 하나
# ------------------------------------------------------------------------------
$HostDirPermissions = @(
    "F:\AppData:smprc:Modify"
    "F:\AppData\Logs:simax:ReadAndExecute"
)

# ------------------------------------------------------------------------------
# 5. OS 파라미터 프로파일
#   config/os_param_profiles/<프로파일명>/registry.reg 를 참조한다
#   (네이티브 .reg 형식 그대로 작성, reg import로 적용).
# ------------------------------------------------------------------------------
$HostOsParamProfile = "DEFAULT"
