#!/bin/bash
# ==============================================================================
# os-setup/linux/config/common.env
# 공통 로깅 함수 + 전역 기본값 + 호스트별 env 파일 로더
# ==============================================================================
# 이 프로젝트는 CSV를 사용하지 않는다. 호스트별 데이터(계정/그룹, 스토리지,
# 디렉터리 권한, OS 파라미터 프로파일 지정)는 모두
#   config/os_env/<hostname>.env
# 파일 안에 bash 배열/변수로 직접 선언한다. 이 파일은 그 env 파일들이
# 공통으로 source하는 로깅 함수 + 헬퍼 모음이다.
# ==============================================================================

# ------------------------------------------------------------------------------
# 경로 계산 (이 파일이 어디서 source 되든 항상 os-setup/linux 기준 절대경로를
# 계산할 수 있도록 함)
# ------------------------------------------------------------------------------
OS_SETUP_LINUX_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_SETUP_LINUX_DIR="$(cd "${OS_SETUP_LINUX_CONFIG_DIR}/.." && pwd)"
ENV_DIR="${OS_SETUP_LINUX_CONFIG_DIR}/os_env"
# ※ sw_modules/setup_sw.sh는 별도로 config/env/<hostname>.env 를 본다
#   (os-setup-main에서 그대로 가져온 것이라 그 경로를 바꾸지 않음).
#   처음엔 이 프로젝트도 같은 config/env/ 를 썼는데, 그러면 계정/스토리지
#   쪽 정의와 SW 모듈 오버라이드가 같은 파일(같은 이름)을 가리키게 되어
#   헷갈린다는 지적을 받아 os_env/ 로 분리함.
OS_PARAM_PROFILE_DIR="${OS_SETUP_LINUX_CONFIG_DIR}/os_param_profiles"
BACKUP_DIR="${OS_SETUP_LINUX_DIR}/tmp"   # rollback용 백업(권한/파일) 및 "우리가 실제로 생성한 것" 기록 위치

# ------------------------------------------------------------------------------
# 실행 로그 취합
#   이 호스트에서 어떤 스크립트가 언제 실행됐는지 한 곳(logs/<hostname>.log)
#   에서 이어서 볼 수 있도록, 모든 log_info/log_warn/log_error/log_success
#   호출이 화면 출력과 동시에 이 파일에도 누적 기록된다(스크립트마다 따로
#   구현할 필요 없이 이 공통 파일 하나만 고치면 전체에 적용됨).
# ------------------------------------------------------------------------------
LOG_DIR="${OS_SETUP_LINUX_DIR}/logs"
mkdir -p "$LOG_DIR" 2>/dev/null
LOG_HOSTNAME="$(hostname -s 2>/dev/null || hostname)"
LOG_FILE="${LOG_DIR}/${LOG_HOSTNAME}.log"

{
    echo ""
    echo "================================================================"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 실행: $(basename "$0") (PID: $$)"
    echo "================================================================"
} >> "$LOG_FILE" 2>/dev/null

# ------------------------------------------------------------------------------
# 표준 로그 함수 (os-setup-main/linus/config/linux_common.env 와 동일한 스타일
# + logs/<hostname>.log 에도 같은 내용을 append)
# ------------------------------------------------------------------------------
log_info()    { local _m="[INFO]    $(date '+%Y-%m-%d %H:%M:%S') - $*"; echo "$_m"; echo "$_m" >> "$LOG_FILE" 2>/dev/null; }
log_warn()    { local _m="[WARN]    $(date '+%Y-%m-%d %H:%M:%S') - $*"; echo "$_m"; echo "$_m" >> "$LOG_FILE" 2>/dev/null; }
log_error()   { local _m="[ERROR]   $(date '+%Y-%m-%d %H:%M:%S') - $*"; echo "$_m"; echo "$_m" >> "$LOG_FILE" 2>/dev/null; }
log_success() { local _m="[SUCCESS] $(date '+%Y-%m-%d %H:%M:%S') - $*"; echo "$_m"; echo "$_m" >> "$LOG_FILE" 2>/dev/null; }

# ------------------------------------------------------------------------------
# 생성 기록(manifest) 헬퍼
#   rollback 스크립트는 HOST_GROUPS/HOST_ACCOUNTS 등 env 정의를 그대로
#   되돌리면 안 된다 - env에는 "이미 존재해야 하는 표준 그룹"처럼 우리가
#   만들지 않은 항목도 섞여 있기 때문에, 그걸 그대로 삭제하면 실서버의
#   wheel 그룹 같은 걸 지워버리는 사고가 난다. 그래서 각 *_gen.sh /
#   *_apply.sh 는 "실제로 자신이 생성/변경한 것"만 아래 manifest 파일에
#   기록하고, rollback은 반드시 이 manifest만 근거로 되돌린다.
# ------------------------------------------------------------------------------
manifest_dir() {
    local d="${BACKUP_DIR}/${HOSTNAME_SHORT}"
    mkdir -p "$d"
    echo "$d"
}

manifest_record() {
    local manifest_name="$1"
    local value="$2"
    echo "$value" >> "$(manifest_dir)/${manifest_name}"
}

manifest_read() {
    local manifest_name="$1"
    local f
    f="$(manifest_dir)/${manifest_name}"
    [ -f "$f" ] && cat "$f"
}

# ------------------------------------------------------------------------------
# OS 파라미터 프로파일 파일(<profile>.param.conf) 파싱 헬퍼
#   sysctl.conf 줄("key = value")과 limits.conf 줄("domain type item value",
#   공백 구분 4컬럼)은 한 파일에 섞어 쓰되, "=" 포함 여부만으로 구분한다.
#   sysctl.conf 형식은 항상 "="를 쓰고, limits.conf 형식은 표준 문법상
#   "="를 쓰지 않으므로 이 판별만으로 충분하다(별도 섹션 마커 불필요).
# ------------------------------------------------------------------------------
extract_sysctl_lines() {
    local profile_file="$1"
    grep -vE '^[[:space:]]*(#|$)' "$profile_file" | grep '='
}

extract_limits_lines() {
    local profile_file="$1"
    grep -vE '^[[:space:]]*(#|$)' "$profile_file" | grep -v '='
}

# ------------------------------------------------------------------------------
# 호스트별 env 파일 로드
#   config/os_env/<hostname>.env 가 없으면 명확히 에러로 중단시킨다(예전
#   os-setup-main 코드가 "경고만 남기고 계속 진행"하다가 빈 배열로 조용히
#   아무 작업도 안 하고 성공한 것처럼 끝나버리는 문제가 있었음 - 이 프로젝트는
#   각 스크립트가 반드시 무엇을 할지 명시적으로 알아야 하므로 실패로 처리).
# ------------------------------------------------------------------------------
load_host_env() {
    local hostname_short
    hostname_short=$(hostname -s)
    local host_env_file="${ENV_DIR}/${hostname_short}.env"

    if [ ! -f "$host_env_file" ]; then
        log_error "호스트 전용 env 파일이 없습니다: ${host_env_file}"
        log_error "이 호스트(${hostname_short})에 대한 설정을 config/os_env/${hostname_short}.env 에 먼저 정의해야 합니다."
        exit 1
    fi

    # set -u 환경에서 호스트 env 파일이 일부 항목(예: HOST_FILESYSTEMS)을
    # 정의하지 않아도 "unbound variable"로 죽지 않도록 먼저 빈 기본값을
    # 채워둔다. 호스트 env 파일에 실제 정의가 있으면 아래 source가 덮어쓴다.
    HOST_GROUPS=()
    HOST_ACCOUNTS=()
    HOST_FILESYSTEMS=()
    HOST_DIR_PERMISSIONS=()
    HOST_OS_PARAM_PROFILE=""
    HOST_INITIAL_PASSWORD=""

    # shellcheck disable=SC1090
    source "$host_env_file"
    log_info "호스트 전용 env 로드 완료: ${hostname_short}.env"
    HOSTNAME_SHORT="$hostname_short"
}

# ------------------------------------------------------------------------------
# 공통 사전 점검
# ------------------------------------------------------------------------------
require_root() {
    if [ "$(id -u)" -ne 0 ]; then
        log_error "root 권한으로 실행해야 합니다."
        exit 1
    fi
}

# 실행 확인 프롬프트 (--yes/-y 로 건너뛸 수 있음)
confirm_or_exit() {
    local message="$1"
    if [ "${ASSUME_YES:-false}" = "true" ]; then
        return 0
    fi
    read -r -p "${message} (y/n): " _confirm
    if [ "$_confirm" != "y" ]; then
        log_warn "사용자가 취소했습니다."
        exit 1
    fi
}

# 커맨드라인에서 -y/--yes 파싱 (각 스크립트 상단에서 호출)
parse_common_args() {
    ASSUME_YES=false
    for arg in "$@"; do
        case "$arg" in
            -y|--yes) ASSUME_YES=true ;;
        esac
    done
}
