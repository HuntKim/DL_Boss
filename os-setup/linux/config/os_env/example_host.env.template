# ==============================================================================
# config/env/<hostname>.env  (예시 템플릿)
# ==============================================================================
# 파일명은 반드시 "hostname -s" 결과와 정확히 일치해야 한다.
# 이 파일 하나가 해당 호스트의 계정/그룹, 스토리지, 디렉터리 권한,
# OS 파라미터 프로파일을 전부 정의한다 (CSV 미사용).
#
# 이 파일을 복사해서 실제 호스트명으로 이름을 바꾸고 값을 채워 사용한다.
#   cp example_host.env.template rtpgarga01m.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 그룹 정의
#   형식: "그룹명:GID"
#   계정보다 먼저 생성되므로 계정에서 참조하는 그룹은 반드시 여기 있어야 한다.
#   이미 시스템에 존재하는 표준 그룹(wheel 등)은 GID를 비워두면
#   ("wheel:") 존재 여부만 확인하고 새로 만들지 않는다.
# ------------------------------------------------------------------------------
HOST_GROUPS=(
    "amsgroup:1001"
    "dba:701"
    "osmanaged:10001"
    "wheel:"
)

# ------------------------------------------------------------------------------
# 2. 계정 정의
#   형식: "계정명:1차그룹:UID:홈디렉터리:로그인쉘:추가그룹(세미콜론구분,옵션)"
# ------------------------------------------------------------------------------
HOST_ACCOUNTS=(
    "amsadmin:amsgroup:1000:/users/amsadmin:/usr/bin/csh:"
    "smprc:simax:700:/users/smprc:/usr/bin/csh:"
    "oracle:dba:705:/oracle:/usr/bin/bash:"
    "osmanaged:osmanaged:10000:/home/osmanaged:/usr/bin/bash:wheel"
)

# 새로 생성되는 모든 계정에 적용할 초기 비밀번호(평문). useradd만으로는
# 계정이 잠긴 상태로 생성되어 로그인이 안 되므로, 이 값으로 chpasswd만
# 설정한다("다음 로그인 시 반드시 변경" 강제는 걸지 않음 - hiware 쪽에서
# 이미 로그인 시 비밀번호 변경을 처리하고 있어 중복 강제 시 오류가 날
# 수 있어서 뺐음). 담당자가 hiware를 통해 곧 변경하는 일회성 값이다.
HOST_INITIAL_PASSWORD="ChangeMe123!"

# ------------------------------------------------------------------------------
# 3. Storage(LVM 볼륨) 정의
#   형식: "마운트포인트:크기(GB):VG명"
#   VG가 없으면 자동으로 생성하고, 빈 디스크를 자동 탐색해 배정한다.
# ------------------------------------------------------------------------------
HOST_FILESYSTEMS=(
    "/home:500:appvg"
    "/usr2:220:appvg"
)

# ------------------------------------------------------------------------------
# 4. 디렉터리 권한 정의 (스토리지 생성과 별개의 단계)
#   형식: "경로:소유자:그룹:권한(octal)"
#   위 HOST_FILESYSTEMS로 만든 마운트포인트 자체의 권한뿐 아니라, 그
#   하위에 있는(별도 볼륨이 아닌) 유저 디렉터리 권한까지 여기서 다룬다.
# ------------------------------------------------------------------------------
HOST_DIR_PERMISSIONS=(
    "/usr2:root:root:755"
    "/usr2/s1p33f:s1ph33f:s1ph33f:755"
    "/oracle:oracle:dba:750"
)

# ------------------------------------------------------------------------------
# 5. OS 파라미터 프로파일
#   config/os_param_profiles/<프로파일명>.param.conf 파일 하나를 참조한다
#   (sysctl/limits 값을 한 파일에 네이티브 형식 그대로 섞어서 작성 - "="
#   포함 줄은 sysctl, 미포함 줄은 limits로 자동 분류됨).
#   프로파일명은 도메인이 아니라 "실제 값이 같은 단위"로 짓는다 - 같은
#   도메인이라도 역할(WEB/WAS/DB)별로 값이 다르면 프로파일을 나눠야 하고,
#   그 서버만 특이하면 프로파일명을 호스트명으로 지어도 된다.
# ------------------------------------------------------------------------------
HOST_OS_PARAM_PROFILE="EES-PHOTO"
