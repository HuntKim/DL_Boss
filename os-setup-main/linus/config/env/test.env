# ==========================================
# Host1 환경 설정 (실제 수집된 스펙 반영)
# ==========================================

# 호스트별 개별 경로 정의
# ==========================================
# JAVA 환경변수 설정
# ==========================================
JDK_PATH_ORACLE_8="/usr/lib/jvm"
JDK_PATH_OPEN_8="/usr/lib/jvm"
JDK_PATH_OPEN_7="/opt/lib/jvm"


# ==========================================
# Oracle 환경변수
# ==========================================
# Cloud OS Tech 운영팀 확인사항 반영: ORACLE_HOME=/oracle, oracle:dba 권한 설정
TARGET_ORACLE_OWNER="oracle:dba"
TARGET_ORACLE_PATH="/home/oracle"
TARGET_STAGE_DIR="/oracle/stage"
TARGET_STAGE_DIR="/oracle/stage"
TARGET_ORACLE_BASE="/oracle/CLIENT"
TARGET_ORACLE_HOME="/oracle/CLIENT/oracle"
TARGET_UNIX_GROUP_NAME="dba"
TARGET_INVENTORY_LOCATION="/oracle/oraInventory"

RL8_ORA_PKG=(
     unzip bc  binutils  elfutils-libelf  elfutils-libelf-devel   glibc  glibc-devel  ksh  libaio  libaio-devel  libXrender  libXtst  libgcc  libnsl  librdmacm  libstdc++  libstdc++-devel  libibverbs  make  policycoreutils  policycoreutils-python-utils  smartmontools  sysstat  unzip
)

RL9_ORA_PKG=(
     unzip bc binutils compat-openssl11 elfutils-libelf  fontconfig glibc glibc-devel ksh libaio libasan liblsan  libX11 libXau libXi libXrender libXtst libxcrypt-compat  libgcc libibverbs libnsl librdmacm libstdc++ libxcb  libvirt-libs make policycoreutils policycoreutils-python-utils smartmontools sysstat
)

## ==========================================
## PKG 설치
## ==========================================
## 작업 디렉터리 및 로그 파일 경로



## ===================================================================
## PERL 설치
## perl-5.26.3-422 설치를 위해 의존성 패키지를 아래 순서로 설치 필요.
## perl-libs-5.26.3-422.el8.0.1.x86_64.rpm
## perl-interpreter-5.26.3-422.el8.0.1.x86_64.rpm
## perl-5.26.3-422.el8.0.1.x86_64.rpm
## perl-5.26.3-422.el8.0.1.x86_64.rpm
## perl-devel-5.26.3-422.el8.0.1.x86_64.rpm
## dnf 등으로 패키지, 대부분의 표준 RPM 설치 시에는 설치 위치 변경 안되는 경우 가 많음
## rpm -qpi ./perl-5.26.3*.rpm 2>/dev/null
## rpm -qpi perl-5.26.3*.rpm | grep -i relocat 실행 시
##  Relocations: (not relocatable)라고 나오면 경로 변경이 불가능합니다.
## 가능한 경우 실행 명령: rpm -ivh --prefix=/opt/perl perl-5.26.3*.rpm
## ===================================================================
## Perl 설치 경로, 설치 전 필수 패키지 목록 및 설치 파일
TARGET_PERL_PATH="/usr2/bin/perl"


# ==============================================================================
# Python 환경 설정
# ==============================================================================
# OS 설치 요청서 기반: smprc 유저 및 /appdata/smprc 경로 설정
PYTHON_OWNER="osmanaged:osmanaged"
PYTHON_PATH="/tmp/os-setup/result/"
# Flask 2.0.3 버전은 최신 Werkzeug와 호환되지 않아 ImportError(url_quote 에러)가 발생하므로, 정상적인 모듈 연동과 검증을 위해 호환 버전(werkzeug==2.0.3)을 추가 설치
PYTHON_LIBRARIES="flask==2.0.3 werkzeug==2.0.3 boto3==1.28.62 python-dateutil==2.9.0post0 pexpect==4.8.0 pyodbc==5.3.0 pandas==2.2.3"

# ==============================================================================
# Node.js 환경 설정
# ==============================================================================
# OS 설치 요청서 기반: pnpm 9.13.0 버전 사용
NODEJS_OWNER="smprc:appgroup"
NODEJS_PATH="/appdata/smprc/"
NODEJS_LIBRARIES="pnpm@9.13.0"

# ==============================================================================
# Nginx 환경 설정
# ==============================================================================
# OS 설치 요청서 설치 경로: /appdata/smprc/nginx 반영
NGINX_OWNER="osmanaged:osmanaged"
NGINX_PATH="/tmp/os-setup/result/"

# ==============================================================================
# Redis 환경 설정
# ==============================================================================
# OS 설치 요청서 설치 경로: /appdata/smprc/redis 반영
REDIS_OWNER="osmanaged:osmanaged"
REDIS_PATH="/tmp/os-setup/result/"
