# sw_modules/config/linux_common.env

# ==========================================  
# 1. 서버 외부 리소스 및 경로 설정 (External URLs & Config)  
# ==========================================  
# 기본 엔드포인트 및 설정 파일 경로  
BASE_URL="https://osmanaged.samsungds.net/os_setup"  
SCRIPT_URL="${BASE_URL}/scripts"  
FILE_URL="${BASE_URL}/files/linux"  
ACCOUNT_CSV_PATH="../config/account.csv"

# ==========================================  
# 2. 서버 내부 작업 환경 설정 (Local Base & Log)  
# ==========================================  
export BASE_DIR="/tmp/os-setup"  
export LOG_DIR="$BASE_DIR/log"  
export TEMP_DIR="$BASE_DIR/sw-tmp"  # 임시 빌드/다운로드용 폴더

# 필수 디렉토리 생성  
mkdir -p "$LOG_DIR" "$TEMP_DIR"

# 공통 로그 함수 정의  
log_info()    { echo -e "[INFO]    $(date '+%Y-%m-%d %H:%M:%S') - [$(hostname -s)] $1"; }  
log_warn()    { echo -e "[WARN]    $(date '+%Y-%m-%d %H:%M:%S') - [$(hostname -s)] $1"; }  
log_error()   { echo -e "[ERROR]   $(date '+%Y-%m-%d %H:%M:%S') - [$(hostname -s)] $1"; }  
log_success() { echo -e "[SUCCESS] $(date '+%Y-%m-%d %H:%M:%S') - [$(hostname -s)] $1"; }

# ==========================================  
# 3. SW 설치 기본값 (Default Settings)  
# ==========================================  
# ※ 주의: 개별 서버 .env 파일이 있으면 아래 값들은 덮어씌워집니다.  
# 기본값으로 root:root 및 /usr/local/ 설정을 유지합니다.  
PYTHON_OWNER="root:root"  
PYTHON_PATH="/usr/local/"

NODEJS_OWNER="root:root"  
NODEJS_PATH="/usr/local/"

NGINX_OWNER="root:root"  
NGINX_PATH="/usr/local/"

REDIS_OWNER="root:root"  
REDIS_PATH="/usr/local/"  


# ==========================================
# 4. 호스트 전용(TARGET_*) 환경변수 우선 적용 함수
#   호스트 env(config/env/<host>.env)에 TARGET_<변수명> 형태의 값이
#   있으면 그 값을 사용하고, 없거나 빈 값이면 이 파일(linux_common.env)의
#   공통 기본값을 그대로 유지한다.
#   ※ 호스트 env가 원래 이름(예: PERL_PATH)을 그대로 다시 정의하면
#     source 시 빈 값이어도 무조건 덮어써질 수 있음.
#     TARGET_ 접두사가 붙은 이름으로만 오버라이드하도록 각 SW 모듈에서
#     사용할 것.
#   사용법(각 install_*.sh 모듈에서, 호스트 env 파일을 source한 뒤 호출):
#     apply_target_override "PERL_PATH"
# ==========================================
apply_target_override() {
    local var_name="$1"
    local target_name="TARGET_${var_name}"
    local target_value="${!target_name:-}"

    if [ -n "$target_value" ]; then
        log_info "${var_name} = ${target_value}  (호스트 전용 설정 ${target_name} 사용)"
        printf -v "$var_name" '%s' "$target_value"
    else
        log_info "${var_name} = ${!var_name:-}  (공통 설정 linux_common.env 사용)"
    fi
}

# ==========================================  
# 5. JDK 설치 기본값 (Default Settings)  
# ==========================================  
# JDK
JAVA_HOME="/usr/java"


# ==========================================  
# 6. Oracle Client 설치 기본값 (Default Settings)  
# ========================================== 
# Oracle Client
ORACLE_OWNER="oracle:dba"
ORACLE_PATH="/oracle"
STAGE_DIR="/oracle/stage"
ORACLE_BASE="/oracle/client"
ORACLE_HOME="/oracle/client"
UNIX_GROUP_NAME="dba"
INVENTORY_LOCATION="/oracle/oraInventory"

## Oracle client 설치 시 필요한 필수 패키지
RL8_ORA_PKG=(
     unzip bc  binutils  elfutils-libelf  elfutils-libelf-devel   glibc  glibc-devel  ksh  libaio  libaio-devel  libXrender  libXtst  libgcc  libnsl  librdmacm  libstdc++  libstdc++-devel  libibverbs  make  policycoreutils  policycoreutils-python-utils  smartmontools  sysstat  unzip
)

RL9_ORA_PKG=(
     unzip bc binutils compat-openssl11 elfutils-libelf  fontconfig glibc glibc-devel ksh libaio libasan liblsan  libX11 libXau libXi libXrender libXtst libxcrypt-compat  libgcc libibverbs libnsl librdmacm libstdc++ libxcb  libvirt-libs make policycoreutils policycoreutils-python-utils smartmontools sysstat
)

# ==========================================  
# 7. Perl 설치 기본값 (Default Settings)  
# ========================================== 
# Perl 기본 설치 위치, 설치 시 필요한 필수 패키지
PERL_PATH="/usr/bin/perl"
PERL_PKG=(
     gcc make glibc-devel
)
